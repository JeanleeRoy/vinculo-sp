# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Database Engine: 'postgres' (Supabase) or 'sqlite'
DATABASE_TYPE=postgres

# Option 1: Supabase Direct Connection URL (recommended)
# Replace with your Supabase connection string:
# e.g., postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Option 2: Individual Supabase / PostgreSQL Credentials
DATABASE_HOST=db.your-project-ref.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password
DATABASE_NAME=vinculo-db
DATABASE_SSL=true

# Supabase API credentials (optional for client integration)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
